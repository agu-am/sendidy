# Token de @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# URL publica SIN barra final (Render: https://tu-app.onrender.com | local: https://xxx.ngrok-free.app)
WEBHOOK_URL=https://tu-app.onrender.com
# Secreto aleatorio min 16 chars (genera con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))")
WEBHOOK_SECRET=cambia-esto-por-32-caracteres-aleatorios
# Supabase -> Connect -> Transaction pooler (puerto 6543). Reemplaza [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Tu Telegram user.id (manda /id al bot en privado). Puedes listar varios con comas.
ADMIN_IDS=123456789
# Pausa entre envios para no comer FloodWait (ms). 80 recomendado para 50 destinos.
SEND_DELAY_MS=80
# TTL cache de admins (segundos).
ADMIN_CACHE_TTL=300
